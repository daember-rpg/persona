<article class="persona-card persona-card--{{kind}} {{#if status}}is-{{status}}{{/if}}" role="dialog" aria-label="{{#if name}}{{name}}{{else}}???{{/if}}" style="--accent: {{accent}}">
    <button type="button" class="persona-card__close" data-action="closeCard" aria-label="{{localize "PERSONA.Close"}}"><i class="fa-solid fa-xmark" inert></i></button>
    <div class="persona-card__art" style="--art: url('{{img}}')">
        <div class="persona-card__frame"><img class="persona-fit" src="{{img}}" style="{{frame}}" alt="" draggable="false"></div>
        <div class="persona-card__id">
            <span class="persona-eyebrow">{{#if faction}}<span class="persona-dot" style="--dot: {{accent}}"></span> {{faction}}{{else}}{{kindLabel}}{{/if}}</span>
            {{#if named}}
                <h3>{{name}}</h3>
                {{#if title}}<p class="persona-card__title">{{title}}</p>{{/if}}
            {{else}}
                <h3 class="is-unknown">???</h3>
            {{/if}}
        </div>
        {{#if hasVideo}}
            {{#if isGM}}
                <div class="persona-card__play persona-card__play--gm">
                    <button type="button" class="persona-button" data-action="playForAll"><i class="fa-solid fa-play" inert></i> {{localize "PERSONA.Video.PlayAll"}}</button>
                    <button type="button" class="persona-icon-btn" data-action="replayVideo" data-tooltip="{{localize "PERSONA.Video.PreviewHint"}}" aria-label="{{localize "PERSONA.Video.PreviewHint"}}"><i class="fa-solid fa-eye" inert></i></button>
                </div>
            {{else}}
                <button type="button" class="persona-button persona-card__play" data-action="replayVideo"><i class="fa-solid fa-play" inert></i> {{localize "PERSONA.Video.Replay"}}</button>
            {{/if}}
        {{/if}}
    </div>
    <div class="persona-card__body">
        {{#if named}}{{#if status}}<p class="persona-status-tag persona-status-tag--card is-{{status}}"><i class="{{statusIcon}}" inert></i> {{statusLabel}}</p>{{/if}}{{/if}}
        {{#if knowledge}}
            <div class="persona-known" data-tooltip="{{localize "PERSONA.Codex.KnownHint"}}">
                <span>{{localize "PERSONA.Codex.Known"}}</span>
                <span class="persona-known__bar"><span style="width: {{knowledge.pct}}%"></span></span>
                <span class="persona-pips">{{#each knowledge.pips as |p|}}<i class="{{#if p.known}}is-known{{/if}} {{#if p.secret}}is-secret{{/if}}"></i>{{/each}}</span>
            </div>
        {{/if}}
        {{#if groups.length}}
            <div class="persona-chips">
                {{#each groups as |group|}}<span class="persona-chip is-static"><span class="persona-dot" style="--dot: {{group.color}}"></span><span>{{group.label}}</span></span>{{/each}}
            </div>
        {{/if}}

        {{#if summary}}
            <section class="persona-entry">
                <h4 class="persona-entry__head">{{localize "PERSONA.Layer.summary"}}</h4>
                <div class="persona-card__summary">{{{summary}}}</div>
            </section>
        {{else if storyLocked}}
            <p class="persona-locked persona-locked--slot"><i class="fa-solid fa-lock" inert></i> {{localize "PERSONA.Codex.StoryLocked"}}</p>
        {{else}}
            <p class="persona-locked"><i class="fa-solid fa-lock" inert></i> {{#if named}}{{localize "PERSONA.Card.LittleKnown"}}{{else}}{{localize "PERSONA.Card.Unknown"}}{{/if}}</p>
        {{/if}}

        {{#if secret}}
            <div class="persona-secret">
                <span class="persona-eyebrow">{{localize "PERSONA.Card.Secret"}}</span>
                <div>{{{secret}}}</div>
            </div>
        {{else if secretLocked}}
            <p class="persona-locked persona-locked--slot"><i class="fa-solid fa-lock" inert></i> {{localize "PERSONA.Codex.SecretLocked"}}</p>
        {{/if}}

        {{#if people.length}}
            <section class="persona-links">
                <span class="persona-eyebrow">{{localize "PERSONA.Card.PeopleHere"}}</span>
                <div class="persona-links__grid">
                    {{#each people as |p|}}
                        <button type="button" class="persona-link {{#if p.hidden}}is-hidden{{/if}}" data-action="openLinked" data-id="{{p.id}}">
                            <img class="persona-fit" src="{{p.img}}" style="{{p.frame}}" alt="" draggable="false"><span>{{p.name}}</span>{{#if p.isNew}}<b>{{localize "PERSONA.New"}}</b>{{/if}}
                        </button>
                    {{/each}}
                </div>
            </section>
        {{/if}}
        {{#if places.length}}
            <section class="persona-links">
                <span class="persona-eyebrow">{{localize "PERSONA.Card.SeenAt"}}</span>
                <div class="persona-chips">
                    {{#each places as |p|}}
                        <button type="button" class="persona-chip" data-action="openLinked" data-id="{{p.id}}"><i class="fa-solid fa-location-dot" inert></i><span>{{p.name}}</span></button>
                    {{/each}}
                </div>
            </section>
        {{/if}}

        {{#if shareTargets}}
            <div class="persona-share persona-share--card">
                <span class="persona-eyebrow">{{localize "PERSONA.Handout.ShowTo"}}</span>
                <div class="persona-chips">
                    {{#each shareTargets as |target|}}
                        <button type="button" class="persona-chip" data-action="showHandout" data-who="{{target.id}}"><i class="{{target.icon}}" inert></i><span>{{target.label}}</span></button>
                    {{/each}}
                </div>
            </div>
        {{/if}}
        {{#if isGM}}
            <div class="persona-audit">
                <span class="persona-eyebrow">{{localize "PERSONA.Card.WhoKnows"}}</span>
                <div class="persona-status persona-status--static">
                    {{#each audit as |layer|}}
                        <span class="persona-status__layer is-{{layer.state}} {{#if layer.disabled}}is-disabled{{/if}}" data-tooltip="{{layer.tooltip}}"><i class="{{layer.icon}}" inert></i><span>{{layer.label}}</span>{{#if layer.count}}<b>{{layer.count}}</b>{{/if}}</span>
                    {{/each}}
                </div>
            </div>
        {{/if}}

        {{> persona-notes}}
    </div>
</article>
