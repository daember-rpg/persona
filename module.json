{
  "id": "persona",
  "title": "Persona",
  "description": "The people and places of your story, revealed when you choose: a player gallery with cards and notes, cards shown to players like handouts, full-screen videos for everyone, and Bonds — each player's own relationship wheel.",
  "version": "0.12.0-alpha",
  "authors": [
    {
      "name": "Fernando Melo (Hello Melo Design)",
      "url": "https://github.com/daember-rpg"
    }
  ],
  "url": "https://github.com/daember-rpg/persona",
  "manifest": "https://raw.githubusercontent.com/daember-rpg/persona/main/module.json",
  "download": "https://raw.githubusercontent.com/daember-rpg/persona/main/dist/persona-0.12.0-alpha.zip",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "relationships": {
    "recommends": [
      {
        "id": "socketlib",
        "type": "module",
        "reason": "Lets players write party notes through the GM."
      },
      {
        "id": "triad",
        "type": "module",
        "reason": "Persona opens as a tab in Triad's tray."
      }
    ]
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/persona.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": true,
  "flags": {}
}
